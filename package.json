{
  "name": "dsh-desktop-tools",
  "version": "0.1.0",
  "description": "Desktop controls for DSH: a Restart button in the title bar and a Start with Windows switch in Settings → General.",
  "type": "module",
  "license": "MIT",
  "author": "Shunin",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "desktop",
    "restart",
    "autostart",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/momiji42/dsh-desktop-tools.git"
  },
  "homepage": "https://github.com/momiji42/dsh-desktop-tools#readme",
  "bugs": {
    "url": "https://github.com/momiji42/dsh-desktop-tools/issues"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs"
  }
}
